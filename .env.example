TG_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_JOB_TIMEOUT=600
GEMINI_POLL_INTERVAL=5
# Необязательно: путь к cookies.txt для роликов, требующих входа в YouTube
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt
LOG_LEVEL=INFO
# Необязательно, если Telegram недоступен без прокси:
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
